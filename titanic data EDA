    {
      "cell_type": "markdown",
      "metadata": {
        "id": "dbbd34e2"
      },
      "source": [
        "#### Simple Matching Dissimilarity"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "a1155c92",
        "outputId": "4e418b3c-e3e0-4674-b9b1-7e376b2b635d"
      },
      "source": [
        "match = 0\n",
        "total = 2\n",
        "\n",
        "if person1[\"Sex\"] == person2[\"Sex\"]:\n",
        "    match += 1\n",
        "\n",
        "if person1[\"Embarked\"] == person2[\"Embarked\"]:\n",
        "    match += 1\n",
        "\n",
        "dissimilarity = 1 - (match / total)\n",
        "\n",
        "print(\"Nominal Dissimilarity =\", dissimilarity)"
      ],
      "execution_count": 30,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Nominal Dissimilarity = 1.0\n"
