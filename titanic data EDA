    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "fe301577"
      },
      "source": [
        "person1 = df.loc[0, [\"Sex\", \"Embarked\"]]\n",
        "person2 = df.loc[1, [\"Sex\", \"Embarked\"]]"
